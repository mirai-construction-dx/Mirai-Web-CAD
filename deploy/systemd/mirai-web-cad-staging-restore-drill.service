[Unit]
Description=Mirai Web CAD Staging isolated PostgreSQL restore drill
After=postgresql.service mirai-web-cad-staging-backup.service
Requires=postgresql.service

# 失敗時はGitHub Issueで通知する(独立レビュー H-3)。
OnFailure=mirai-web-cad-notify-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/.local/share/mirai-web-cad/staging-runtime/current
EnvironmentFile=/home/kensan/.config/mirai-web-cad/staging-backup.env
Environment=PG_BIN=/usr/lib/postgresql/16/bin
Environment=BACKUP_DIR=/var/backups/mirai-web-cad/staging-postgres
Environment=EXPECTED_RESTORE_DATABASE=mirai_web_cad_staging_recovery
# 復元元(manifestのdatabase=)の検証(改善台帳P0-84)。
Environment=EXPECTED_DATABASE=mirai_web_cad_staging
Environment=PATH=/home/kensan/.npm-global/bin:/home/kensan/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash scripts/restore-drill-local.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/backups/mirai-web-cad/staging-postgres
UMask=0077
