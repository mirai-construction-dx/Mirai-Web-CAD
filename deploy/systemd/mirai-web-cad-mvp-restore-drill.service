[Unit]
Description=Mirai Web CAD MVP isolated PostgreSQL restore drill
After=postgresql.service mirai-web-cad-mvp-backup.service
Requires=postgresql.service

# 失敗時はGitHub Issueで通知する(独立レビュー H-3)。
OnFailure=mirai-web-cad-notify-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-Construction-DX/Mirai-Web-CAD
EnvironmentFile=/home/kensan/.config/mirai-web-cad/mvp-backup.env
Environment=PG_BIN=/usr/lib/postgresql/16/bin
Environment=BACKUP_DIR=/var/backups/mirai-web-cad/mvp-postgres
Environment=EXPECTED_RESTORE_DATABASE=mirai_web_cad_mvp_recovery
# 復元元(manifestのdatabase=)の検証(改善台帳P0-84)。
Environment=EXPECTED_DATABASE=mirai_web_cad_mvp
Environment=PATH=/home/kensan/.npm-global/bin:/home/kensan/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash scripts/restore-drill-local.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/backups/mirai-web-cad/mvp-postgres
UMask=0077
