[Unit]
Description=Mirai Web CAD MVP local database and Access boundary monitor
After=network-online.target postgresql.service mirai-web-cad-mvp.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-Construction-DX/Mirai-Web-CAD
EnvironmentFile=/home/kensan/.config/mirai-web-cad/mvp.env
Environment=LOCAL_URL=http://127.0.0.1:18813
Environment=PUBLIC_URL=https://mirai-web-cad-mvp.mirai-dx-platform.com
Environment=EXPECTED_DATABASE=mirai_web_cad_mvp
Environment=PG_BIN=/usr/lib/postgresql/16/bin
ExecStart=/usr/bin/bash scripts/check-mvp-health.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
