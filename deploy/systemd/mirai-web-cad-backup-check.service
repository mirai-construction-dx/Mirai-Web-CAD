[Unit]
Description=Mirai Web CAD backup freshness check

# 失敗時はGitHub Issueで通知する(独立レビュー H-3)。
OnFailure=mirai-web-cad-notify-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-Construction-DX/Mirai-Web-CAD
Environment=BACKUP_DIR=/var/backups/mirai-web-cad/postgres
Environment=MAX_AGE_HOURS=36
ExecStart=/usr/bin/bash scripts/check-backup-freshness.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
