[Unit]
Description=Mirai Web CAD deploy provenance drift check
Documentation=https://github.com/mirai-construction-dx/Mirai-Web-CAD/blob/main/docs/operations.md
After=network-online.target mirai-web-cad.service
Wants=network-online.target
Wants=mirai-web-cad.service

[Service]
Type=oneshot
User=kensan
Group=kensan
# WorkingDirectory は本番ホストのチェックアウト先。他の mirai-web-cad-* unit と必ず揃えること。
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Mirai-Web-CAD
Environment=PATH=/home/kensan/.npm-global/bin:/home/kensan/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# --url で稼働中プロセスのcommitも突き合わせる(作業ツリーだけでは再起動漏れを検出できない)。
ExecStart=/usr/bin/env node scripts/check-deploy-drift.mjs --url http://127.0.0.1:18812
# 乖離を検出した場合は非ゼロ終了し、journalに理由を残す(systemctl status / journalctlで確認)。
# 通知連携(Teams/メール)は Issue #8 で扱う。

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
