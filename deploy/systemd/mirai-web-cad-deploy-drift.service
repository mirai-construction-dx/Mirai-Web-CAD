[Unit]
Description=Mirai Web CAD deploy provenance drift check
Documentation=https://github.com/mirai-construction-dx/Mirai-Web-CAD/blob/main/docs/operations.md
After=network-online.target mirai-web-cad.service
Wants=network-online.target
Wants=mirai-web-cad.service

# 乖離検出の失敗はGitHub Issueで通知する(独立レビュー 2026-10-02)。
OnFailure=mirai-web-cad-notify-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
# WorkingDirectory は本番ホストのチェックアウト先。他の mirai-web-cad-* unit と必ず揃えること。
WorkingDirectory=/home/kensan/Projects/Mirai-Construction-DX/Mirai-Web-CAD
Environment=PATH=/home/kensan/.npm-global/bin:/home/kensan/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# --url で稼働中プロセスのcommitも突き合わせる(作業ツリーだけでは再起動漏れを検出できない)。
# Type=oneshotの複数ExecStartは先行行の失敗で後続行を実行しないため、単一のbashで
# 本番(18812)とMVP(18813)を両方実行し、どちらか片方でも失敗したら非ゼロ終了する
# (独立レビュー 2026-10-02)。乖離時はOnFailureでIssue通知される。
ExecStart=/bin/bash -c 'fail=0; node scripts/check-deploy-drift.mjs --url http://127.0.0.1:18812 || fail=1; node scripts/check-deploy-drift.mjs --url http://127.0.0.1:18813 || fail=1; exit $fail'

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
