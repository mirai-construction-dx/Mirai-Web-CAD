{
  "name": "mirai-web-cad",
  "version": "0.1.0-mvp",
  "private": true,
  "type": "module",
  "description": "Mirai Web CAD MVP - browser-based agentic 2D CAD prototype",
  "scripts": {
    "dev": "npm run build && node scripts/serve-local.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:static": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "a11y": "node scripts/a11y-static.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:mvp": "node scripts/verify-mvp-domain.mjs",
    "db:verify": "bash scripts/verify-database.sh",
    "db:check": "bash scripts/check-database-state.sh",
    "db:backup": "bash scripts/backup-database.sh",
    "db:restore": "bash scripts/restore-database.sh",
    "db:backup:local": "bash scripts/backup-local.sh",
    "build": "node scripts/build.mjs",
    "start:production": "node scripts/serve-production.mjs",
    "deploy:local": "bash scripts/deploy-local.sh",
    "deploy:drift": "node scripts/check-deploy-drift.mjs",
    "deploy:drift:live": "node scripts/check-deploy-drift.mjs --url http://127.0.0.1:18812",
    "compat:report": "node scripts/compat-report.mjs",
    "compat:explain": "node scripts/compat-report.mjs --explain",
    "corpus:validate": "node scripts/corpus-ledger.mjs validate",
    "corpus:stats": "node scripts/corpus-ledger.mjs stats",
    "corpus:render": "node scripts/corpus-ledger.mjs render",
    "infra:check": "node scripts/check-cloudflare-iac.mjs",
    "verify:fast": "npm run lint && npm run lint:static && npm run typecheck && npm run a11y && npm test && npm run build",
    "verify": "npm run verify:fast && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "dxf-parser": "1.1.2",
    "jose": "^6.2.12",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "hcl2-parser": "^1.0.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.0"
  }
}
