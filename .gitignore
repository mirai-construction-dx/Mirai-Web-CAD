# dist と node_modules はデプロイ後に .releases/<sha>/ へのsymlinkになる。
# 末尾が/のパターンはディレクトリにしか一致せずsymlinkを無視できないため、/を付けない。
/dist
.wrangler/
/node_modules
/.releases/
/.swap-*
playwright-report/
artifacts/
test-results/
.env
*.env

# Terraformの実値・state・provider実体はリポジトリに含めない
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# 実案件図面の実体(著作権・機密保持のためコミットしない)。docs/compat-corpus/参照
corpus/
sample/

# Synthetic corpus outputs are regenerated from the supplied source.
DXF-Test-Corpus/**/*.dxf
DXF-Test-Corpus/**/__pycache__/
DXF-Test-Corpus/00_manifest/corpus_manifest.*
DXF-Test-Corpus/00_manifest/verification.json
DXF-Test-Corpus/.write_test
DXF-Test-Corpus/**/.write_test
